#!/bin/sh
# Blocks direct pushes to main (TD-5): main changes only through PRs from dev.
# Enabled by `bun install` (package.json "prepare" sets core.hooksPath).
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Blocked: direct push to main. Push to dev and open a PR from dev (see TD-5)." >&2
    exit 1
  fi
done
exit 0
